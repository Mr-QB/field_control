Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
    Frame Rate: 30
  # RViz activates the first tool in this list when the config is loaded.
  # Put MoveCamera first so left-button drag always controls the camera.
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: moveit_rviz_plugin/PlanningScene
      Name: Robot and obstacles
      Enabled: true
      Planning Scene Topic: /monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 0.85
      Scene Robot:
        Robot Alpha: 1
        # Match the geometry used by FCL/checkRobotCollision.  Visual meshes
        # can differ in size and make a real collision look "too early".
        Show Robot Visual: false
        Show Robot Collision: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Pitch: 0.5
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
Window Geometry:
  Width: 1200
  Height: 800
